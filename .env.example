DISCORD_TOKEN=
# Comma-separated guild IDs to sync slash commands to (instant). Empty = global (~1h propagation).
GUILD_IDS=
AUDIO_SOURCE=BotSink.monitor
# Optional opus bitrate cap (kbps). Empty = each server's boost-tier max.
OPUS_BITRATE=
# Rich-presence MPRIS player (substring match). Empty = first available.
MPRIS_PLAYER=
PRESENCE_POLL_SECONDS=3
# Apple Music control (/ecasearch, /ecaskip, /ecapause) over ADB into WayDroid.
# Storefront of the account signed into the app; results are limited to it.
APPLE_MUSIC_STOREFRONT=cn
# Stores searched via the iTunes Search API if the storefront's web search breaks.
ITUNES_SEARCH_STOREFRONTS=us,hk,tw,jp
WAYDROID_ADB=192.168.240.112:5555
ADB_KEY=~/.config/musicbot/adbkey
# Who may control playback (comma-separated IDs). Both empty = everyone.
CONTROL_ROLE_IDS=
CONTROL_USER_IDS=
